{
	"name": "pix",
	"version": "0.1.0",
	"description": "OpenDDE Harness' look for the pi coding agent: kaomoji working indicator, flavour verbs, Claude Code's user message band and tool rows, a turn summary, and the claude-dark / claude-light themes",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-theme",
		"theme",
		"kaomoji"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrzzmrzz/pix.git"
	},
	"homepage": "https://github.com/mrzzmrzz/pix#readme",
	"bugs": {
		"url": "https://github.com/mrzzmrzz/pix/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"src",
		"themes",
		"LICENSES",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/indicator.ts",
			"./src/user-band.ts",
			"./src/thinking.ts",
			"./src/tool-rows.ts",
			"./src/turn-summary.ts"
		],
		"themes": [
			"./themes"
		]
	},
	"scripts": {
		"type-check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"sync-themes": "node scripts/sync-themes.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^25.0.0",
		"typescript": "^5.7.0",
		"vitest": "^4.0.0"
	}
}
